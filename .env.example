# ── LLM Provider ────────────────────────────────────────────────────────────────
# Obtain a free key at https://console.groq.com
GROQ_API_KEY=GROQ_API_KEY=your_groq_api_key_here

# Groq model to use. Recommended options:
#   llama-3.1-70b-versatile  (default — good balance of quality and speed)
#   llama-3.3-70b-versatile  (newer variant)
#   llama-3.1-8b-instant     (faster, lower quality)
GROQ_MODEL_NAME=llama-3.1-70b-versatile

# ── Embeddings ───────────────────────────────────────────────────────────────────
# HuggingFace model for document and query embeddings (downloaded automatically)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── ChromaDB ─────────────────────────────────────────────────────────────────────
CHROMA_COLLECTION_NAME=parking_knowledge

# ── RAG Retrieval ────────────────────────────────────────────────────────────────
# Number of documents to retrieve per query
RETRIEVAL_K=4

# ── Admin (Stage 2) ──────────────────────────────────────────────────────────────
# Password for the administrator dashboard.  Set a strong value in production.
# Never commit the real password — this file is an example only.
ADMIN_PASSWORD=123456

# ── Logging ──────────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
